# 复制本文件为 .env 并填入你自己的凭据。.env 不会进入日志、不要提交到任何仓库。

# ===== LLM 兜底(可选,默认关闭)=====
# OpenAI 兼容接口的 key。启用需在 config.json 里把 llm.enabled 设为 true。
LLM_API_KEY=

# ===== 告警/手机通知通道(可选)=====

# 【Server酱 → 个人微信】(当前启用):去 https://sct.ftqq.com 微信扫码登录,复制 SendKey(以 SCT 开头)
SERVERCHAN_KEY=

# 【企业微信 · 群机器人】(推荐,最省事):在企业微信群里加"群机器人",复制它的 Webhook 地址填这里
WECOM_WEBHOOK=

# 【企业微信 · 自建应用】(开发者方式,二选一):在企业微信管理后台建应用后获取
WECOM_CORPID=
WECOM_SECRET=
WECOM_AGENTID=

# 飞书自定义机器人 webhook(可选)
FEISHU_WEBHOOK=

# Telegram Bot(可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Google Sheets/Docs 输出(可选,默认用本地 xlsx)=====
# service account 的 JSON 文件路径(绝对路径),用于把结果写到 Google Sheets、
# 以及登录失效时在 Google Docs 新建情况说明文件。
GOOGLE_SERVICE_ACCOUNT_JSON=
