{
  "brand": "KANS",
  "market": {
    "code": "VN",
    "name": "越南",
    "currency": "VND",
    "symbols": [
      "₫",
      "đ",
      "VND"
    ],
    "tzOffsetHours": 7,
    "rateToCny": 3891
  },
  "costThresholdCNY": 70,
  "roiThreshold": 2,
  "sevenDayHours": [
    10,
    14
  ],
  "browser": {
    "headless": false,
    "userDataDir": "./data/tiktok-profile",
    "channel": "chromium",
    "slowMoMs": 0,
    "navTimeoutMs": 45000,
    "firstWaitMs": 2500,
    "minRandomDelayMs": 800,
    "maxRandomDelayMs": 2200,
    "waitUntil": "commit",
    "gotoRetries": 3,
    "tableTimeoutMs": 60000,
    "blockHeavyResources": true,
    "boardTableTimeoutMs": 90000
  },
  "output": {
    "mode": "local",
    "dir": "./output",
    "format": "xlsx",
    "gdrive": {
      "enabled": true,
      "remote": "gdrive",
      "rootFolderId": ""
    }
  },
  "llm": {
    "enabled": false,
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "${LLM_API_KEY}",
    "model": "gpt-4o-mini",
    "timeoutMs": 30000,
    "maxCallsPerRun": 10
  },
  "notify": {
    "channels": [
      "log",
      "file"
    ],
    "alertChannels": [
      "log",
      "file",
      "serverchan"
    ],
    "redAlert": {
      "costThresholdCNY": 200,
      "roiThreshold": 1
    },
    "serverchanKey": "${SERVERCHAN_KEY}",
    "wecomWebhook": "${WECOM_WEBHOOK}",
    "wecomApp": {
      "corpid": "${WECOM_CORPID}",
      "corpsecret": "${WECOM_SECRET}",
      "agentid": "${WECOM_AGENTID}",
      "touser": "@all"
    },
    "feishuWebhook": "${FEISHU_WEBHOOK}",
    "telegram": {
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "chatId": "${TELEGRAM_CHAT_ID}"
    }
  },
  "feishu": {
    "enabled": false,
    "appId": "",
    "appSecret": "",
    "chatId": "",
    "chatName": "越南韩束ROI预警",
    "bitable": {
      "appToken": "填多维表格appToken",
      "tableId": "tbl填表ID",
      "dailyTableId": "tbl填表ID",
      "boardTableId": "tbl填表ID"
    },
    "dailySummaryHour": 9,
    "board": {
      "enabled": false,
      "everyMinutes": 30,
      "timeoutMinutes": 6
    }
  },
  "autoDiscoverCampaigns": false,
  "stability": {
    "roundTimeoutMinutes": 40,
    "roundSoftBudgetMinutes": 25,
    "abortAfterFailedCampaigns": 4,
    "loginProbeCampaigns": 3,
    "retryDelayMinutes": 6,
    "maxRetriesPerHour": 2,
    "alertAfterConsecutiveFailures": 2,
    "alertRepeatEveryFailures": 6,
    "restartBrowserEveryRounds": 12,
    "maxBrowserRestartsPerRound": 1
  }
}
